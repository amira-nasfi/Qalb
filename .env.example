# Qalb Environment Variables
# Copy this file to .env and fill in real values before running.

# Django
SECRET_KEY=change-me-to-a-long-random-string-50-chars
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://qalb_user:change-me-strong-password@db:5432/qalb_db

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Encryption (django-encrypted-model-fields)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-fernet-key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Frontend
VITE_API_BASE_URL=http://localhost:8000
